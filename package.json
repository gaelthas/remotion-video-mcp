{
  "name": "remotion-video-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-install Remotion video runtime: MCP server, executable entry points and a file-only agent skill",
  "bin": {
    "remotion-video-mcp": "server/stdio.mjs",
    "remotion-video-mcp-http": "server/http.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "install:all": "node scripts/install.mjs",
    "start": "node server/stdio.mjs",
    "start:http": "node server/http.mjs",
    "check": "node scripts/check.mjs",
    "selftest": "node scripts/selftest.mjs",
    "selftest:http": "node scripts/selftest-http.mjs",
    "smoke": "node scripts/smoke-render.mjs",
    "upgrade": "node scripts/upgrade-runtime.mjs",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.543",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
